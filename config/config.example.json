{
  "defaultPolicy": {
    "tools": "ask",
    "bash": "ask",
    "mcp": "ask",
    "skills": "ask",
    "special": "ask"
  },
  "tools": {
    "read": "allow",
    "read:/home/alice/project/generated/*": "allow",
    "write": "ask",
    "write:/home/alice/project/generated/*": "allow"
  },
  "bash": {
    "allow": ["cargo check", "cargo test", "bun test", "gh run view"],
    "ask": ["git diff"],
    "deny": ["git push --force"],
    "syntax": {
      "subshells": "deny",
      "unanalyzable": "ask"
    },
    "registryOverrides": {}
  },
  "protectedPaths": ["*.secret"],
  "mcp": {
    "mcp_status": "allow"
  },
  "skills": {
    "*": "ask"
  },
  "special": {
    "doom_loop": "deny",
    "external_directory": "ask",
    "external_directory:/home/alice/shared/*": "allow"
  }
}
